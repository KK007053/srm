<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI ตอบคำถาม</title>
    <style>
        body { font-family: Arial, sans-serif; max-width: 600px; margin: 40px auto; padding: 20px; }
        .chat-box { border: 1px solid #ccc; padding: 15px; height: 300px; overflow-y: scroll; margin-bottom: 10px; border-radius: 8px; }
        .user-msg { color: blue; margin: 5px 0; text-align: right; }
        .ai-msg { color: green; margin: 5px 0; text-align: left; }
        input[type="text"] { width: 75%; padding: 10px; }
        button { padding: 10px 15px; cursor: pointer; }
        .config { margin-bottom: 15px; }
    </style>
</head>
<body>

    <h2>🤖 เว็บ AI ตอบคำถาม</h2>

    <div class="config">
        <label>ใส่ Gemini API Key ของคุณ:</label><br>
        <input type="password" id="apiKey" placeholder="AIzaSy..." style="width: 100%; margin-top: 5px;">
    </div>

    <div class="chat-box" id="chatBox"></div>

    <input type="text" id="userInput" placeholder="พิมพ์คำถามที่นี่...">
    <button onclick="sendMessage()">ส่งคำถาม</button>

    <script>
        async function sendMessage() {
            const apiKey = document.getElementById('apiKey').value;
            const input = document.getElementById('userInput');
            const chatBox = document.getElementById('chatBox');
            const message = input.value.trim();

            if (!apiKey) { alert('กรุณาใส่ API Key ก่อนครับ'); return; }
            if (!message) return;

            // แสดงคำถามฝั่งผู้ใช้
            chatBox.innerHTML += `<div class="user-msg"><b>คุณ:</b> ${message}</div>`;
            input.value = '';
            chatBox.scrollTop = chatBox.scrollHeight;

            try {
                // เรียกใช้ Gemini API ฟรี
                const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${apiKey}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        contents: [{ parts: [{ text: message }] }]
                    })
                });

                const data = await response.json();
                const aiReply = data.candidates[0].content.parts[0].text;
                chatBox.innerHTML += `<div class="ai-msg"><b>AI:</b> ${aiReply}</div>`;
            } catch (error) {
                chatBox.innerHTML += `<div class="ai-msg" style="color:red;"><b>เกิดข้อผิดพลาด:</b> ตรวจสอบ API Key อีกครั้ง</div>`;
            }
            chatBox.scrollTop = chatBox.scrollHeight;
        }
    </script>
</body>
</html>
